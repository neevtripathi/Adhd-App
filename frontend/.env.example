# Base URL of the backend API (no trailing slash, no /api suffix).
# Leave UNSET for local dev (Vite proxies /api to localhost:3001, see
# vite.config.ts) and for the combined Netlify deploy (frontend + backend
# function share one site, so relative /api already resolves correctly via
# the netlify.toml redirect). Only set this if the backend is hosted on a
# separate origin from the frontend.
# VITE_API_URL=https://your-backend.example.com
