# Port the backend listens on. Most deploy platforms inject this automatically.
PORT=3001

# Comma-separated list of allowed frontend origins for CORS. Use * to allow all.
# Add your deployed Netlify site URL here once the frontend is live, e.g.:
# ALLOWED_ORIGINS=http://localhost:5173,https://your-site.netlify.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URL of the deployed FastAPI model server. Defaults to http://localhost:9090
# for local dev if unset; override to point at a deployed instance.
MODEL_SERVER_URL=http://localhost:9090
